{
  "name": "05-noc",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch --exclude 'logs/**' src/app.ts",
    "build": "rimraf ./dist && tsc",
    "start": "npm run build && node dist/app.js",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev --name init",
    "postinstall": "npm run generate",
    "setup": "docker compose --project-name noc-dev up -d && npm run migrate",
    "docker:test": "docker compose -f docker-compose.test.yml --project-name noc-test --env-file .env.test up -d",
    "test": "npm run docker:test && jest",
    "test:watch": "npm run docker:test && jest --watchAll",
    "test:coverage": "npm run docker:test && jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.3.0",
    "prisma": "^7.6.0",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "cron": "^4.4.0",
    "dotenv": "^17.4.0",
    "env-var": "^7.5.0",
    "mongoose": "^9.4.1",
    "nodemailer": "^8.0.4",
    "pg": "^8.20.0"
  }
}
